{
  "name": "@wai023/recorder",
  "version": "0.1.2",
  "type": "module",
  "description": "Record audio on the island, save as WAV and add to the file shelf",
  "license": "MIT",
  "author": "wai023",
  "repository": "github:wai023/recorder",
  "engines": {
    "fuyu": ">=0.3.10"
  },
  "scripts": {
    "dev": "fuyu-plugin dev --config build.config.json",
    "build": "fuyu-plugin build --config build.config.json",
    "check": "fuyu-plugin check",
    "package": "fuyu-plugin pack --config build.config.json",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "npm run build && node --experimental-strip-types --test test/protocol.test.mjs test/config.test.mjs test/host.test.mjs && node --test test/e2e.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "eslint": "^10.14.0",
    "fuyu-plugin": "^2.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.1"
  },
  "fuyu": {
    "manifest": 1,
    "displayName": {
      "zh-CN": "录音",
      "en": "Recorder"
    },
    "description": {
      "zh-CN": "在浮屿上录音，保存为 WAV 并加入文件中转",
      "en": "Record audio on the island, save as WAV and add to the file shelf"
    },
    "icon": "assets/icon.svg",
    "categories": [
      "productivity"
    ],
    "platforms": [
      "windows"
    ],
    "host": "dist/host.js",
    "client": {
      "island": "dist/island.js"
    },
    "config": "dist/config.schema.json",
    "inject": {
      "required": [
        "clients",
        "commands",
        "file-shelf/v1",
        "messages/v1"
      ],
      "optional": [
        "plugin-config/v1"
      ]
    },
    "slots": [
      "island.page/v1",
      "island.collapsed/v1",
      "island.widget/v1"
    ],
    "commands": [
      {
        "id": "toggle",
        "title": {
          "zh-CN": "开始/停止录音",
          "en": "Start / stop recording"
        },
        "keybinding": "Ctrl+Alt+R"
      },
      {
        "id": "pause",
        "title": {
          "zh-CN": "暂停/继续录音",
          "en": "Pause / resume recording"
        },
        "keybinding": "Ctrl+Alt+P"
      }
    ]
  }
}
